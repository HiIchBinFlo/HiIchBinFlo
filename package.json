{
  "name": "fivem-clothing-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Professional desktop editor for FiveM clothing resources (drawables, textures, ymt/meta metadata) with a CodeWalker-grade workflow.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:sidecar": "node scripts/publish-sidecar.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit"
  },
