{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FiveM Clothing Studio",
  "version": "0.1.0",
  "identifier": "studio.fivemclothing.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "beforeBuildCommand": "npm run build:sidecar && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FiveM Clothing Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/codewalker-bridge"]
  }
}
