    "rig_", "rig:", "def-", "def_", "org-", "mch-", "ctrl_", "jnt_", "j_", "b_", "bn_"
  ],

  "roles": {
    "root": ["root", "reference", "skel_root", "rootnode", "armature", "trajectory", "bip01"],
    "pelvis": ["hips", "pelvis", "skel_pelvis", "hip", "cog", "bip01pelvis", "j_bip_c_hips", "torso"],
    "spine_root": ["spineroot", "skel_spineroot", "lowerspine"],
